generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Daily granularity ads data (campaign-level) ───────────────────────────────
model AdsMetricDaily {
  campaignId  String
  date        String      // "YYYY-MM-DD"
  clinicName  String      // Ad account name
  pageName    String      @default("")
  pageId      String      @default("")
  adAccountId String      @default("")
  campaign    String
  spend       Float       @default(0)
  inbox       Int         @default(0)
  leads       Int         @default(0)
  cpl         Float       @default(0)
  cpi         Float       @default(0)
  impressions Int         @default(0)
  clicks      Int         @default(0)
  ctr         Float       @default(0)
  status      String      @default("active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@id([campaignId, date])
  @@index([date])
  @@index([adAccountId])
  @@index([pageId])
}

// ── Ad-level daily data (creative + engagement) ───────────────────────────────
model AdsContentDaily {
  adId          String
  date          String        // "YYYY-MM-DD"
  campaignId    String
  adAccountId   String        @default("")
  pageId        String        @default("")
  adName        String        @default("")
  campaignName  String        @default("")
  thumbnailUrl  String        @default("")   // Creative preview image URL
  mediaType     String        @default("")   // "image" | "video" | ""
  spend         Float         @default(0)
  impressions   Int           @default(0)
  clicks        Int           @default(0)
  inbox         Int           @default(0)
  leads         Int           @default(0)
  cpi           Float         @default(0)
  likes         Int           @default(0)
  comments      Int           @default(0)
  shares        Int           @default(0)
  videoViews    Int           @default(0)
  ctr           Float         @default(0)
  creativeId    String        @default("")   // Meta creative ID
  imageHash     String        @default("")   // Image hash for grouping
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@id([adId, date])
  @@index([campaignId])
  @@index([pageId])
  @@index([date])
}

// ── Page name cache (persistent) ──────────────────────────────────────────────
model PageNameCache {
  pageId    String   @id
  pageName  String
  source    String   @default("api")  // "api" | "scrape" | "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
