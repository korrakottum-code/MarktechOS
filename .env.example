# Supabase Auth (browser-safe public values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database: use the Supabase pooler URL at runtime. Keep the direct connection
# only for migrations/admin commands; never expose either URL to the browser.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Meta system-user access tokens
META_SYSTEM_USER_TOKEN=
META_SYSTEM_USER_TOKEN_2=
META_SYSTEM_USER_TOKEN_3=

# Required for scheduled sync calls: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
